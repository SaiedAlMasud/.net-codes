
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<table class="table table-bordered">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>CGPA</th>
        <th>Roll No</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.StudentId</td>
            <td>@item.Name</td>
            <td>@item.Roll</td>
            <th>@item.Cgpa</th>
        </tr>
    }
</table>

